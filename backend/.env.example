# Copy to .env and fill in. Nothing here is required to run the app —
# every integration below degrades gracefully (logs "skipped") if unset.

PORT=3001
JWT_SECRET=
DB_PATH=

# Resend (admin/customer email notifications + daily expiry alerts)
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_TO=
REPLY_TO=
EXPIRY_WARN_DAYS=30

# DVSA MOT History API (https://documentation.history.mot.api.gov.uk/)
# Apply for access there first — DVSA issues these after manual approval.
# Credentials are server-side only — never expose these to the frontend.
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_API_KEY=
MOT_SCOPE_URL=
MOT_TOKEN_URL=
# MOT_API_BASE_URL has a working default, only set to override it.

# Driver photo pipeline — signs the tokenised /p/:token photo links sent
# in SMS/email confirmations. Generate with: openssl rand -hex 32
PHOTO_TOKEN_SECRET=
# PHOTO_STORAGE_DIR has a working default (backend/driver-photos), only
# set this if you've attached a Render persistent disk at a different path.
PHOTO_STORAGE_DIR=

# SMS confirmations — set SMS_PROVIDER to 'twilio' or 'vonage' plus the
# matching credentials below. Leave unset to no-op (email still sends).
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=
